<Project>
  <!-- Windows App SDK's buildTransitive forces UseWinUI=true onto any project
       that (transitively) references a WinUI project, which breaks the MSTest
       host (runtimeconfig generation is suppressed). Re-pin the test-host
       properties after all package imports; opt back in per project with
       ForceWinUITestHost=true when a test really hosts WinUI. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' And '$(ForceWinUITestHost)' != 'true'">
    <UseWinUI>false</UseWinUI>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''"></VersionSuffix>
    <Version Condition="'$(Version)' == '' and '$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <Version Condition="'$(Version)' == '' and '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <RepositoryUrl>https://github.com/Na-Bian/LyricsX-menubar</RepositoryUrl>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
