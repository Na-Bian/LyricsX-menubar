<Window
    x:Class="LyricsX.Windows.TestMediaApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LyricsX Test Media">
  <StackPanel Padding="16" Spacing="8">
    <TextBlock x:Name="StatusText" Text="test media app ready" />
    <Button x:Name="PlayButton" Content="Play" Click="OnPlay" />
    <Button x:Name="PauseButton" Content="Pause" Click="OnPause" />
    <Button x:Name="NextButton" Content="Next" Click="OnNext" />
  </StackPanel>
</Window>
